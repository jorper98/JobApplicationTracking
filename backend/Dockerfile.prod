# Production backend image: hardened (non-root user, uvicorn workers).

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p uploads && chown -R 10001:10001 /app
USER 10001

EXPOSE 8136
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8136} --workers ${UVICORN_WORKERS:-2}