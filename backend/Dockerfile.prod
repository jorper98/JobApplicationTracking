# Production backend image: hardened (non-root user, uvicorn workers).

FROM python:3.11-slim

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/app/.ms-playwright

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && playwright install --with-deps chromium

COPY . .

RUN mkdir -p uploads && chown -R 10001:10001 /app
USER 10001

EXPOSE 8136
# Single worker by default: settings saved via the admin UI (SMTP, AI keys)
# are applied to in-process settings, and rate limits are per-process. With
# multiple workers they would diverge until restart. Set UVICORN_WORKERS>1
# only when the config source is made shared across processes.
CMD uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8136} --workers ${UVICORN_WORKERS:-1}