# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_tracker

# Gemini (free)
GEMINI_API_KEY=AIza-paste-your-real-key-here

# Auth (internal JWT)
# REQUIRED: used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Optional: legacy-migration bootstrap account. If empty, a random password
# is generated and printed in the backend logs on first migration.
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=

# App
DEBUG=true

