# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/job_tracker

# Gemini (free)
GEMINI_API_KEY=AIza-paste-your-real-key-here
# Model used for AI features; first candidate, with real fallbacks after it.
GEMINI_MODEL=gemini-3.6-flash
# Optional: fallback models tried in order when the primary is unavailable.
# GEMINI_FALLBACK_MODELS=["gemini-3.6-flash","gemini-3.5-flash-lite"]

# Auth (internal JWT)
# REQUIRED: used to sign session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Session cookie: set COOKIE_SECURE=true when the API is served over HTTPS.
COOKIE_SECURE=false
# Set true only when the API runs behind a reverse proxy that overwrites
# X-Forwarded-For with the real client IP. When false (default), clients
# cannot spoof that header to bypass the login/register/resend rate limits.
TRUST_PROXY_HEADERS=false
# Per-user daily AI call cap (match analysis, cover letters, URL import).
AI_DAILY_QUOTA=40
# Bootstrap admin account for fresh installs (first startup, only when the
# users table is empty). If the password is empty, a random one is generated
# and printed in the backend logs.
DEFAULT_ADMIN_EMAIL=admin@local
DEFAULT_ADMIN_PASSWORD=

# Email (SMTP) - registration email verification (double opt-in).
# When SMTP is not configured, new registrations are auto-verified (dev mode).
# All values can also be set from the admin Settings page (persisted in DB).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=JobApplicationTracker
# Optional: blind-copy every outgoing email to this address.
SMTP_BCC=
SMTP_TLS=true
SMTP_SSL=false

# App
# Code default is False (safe). Set true for local dev: enables /docs and
# the /api/debug routes. Never set true in production.
DEBUG=true

