# Copy this file to "deploy/.env.prod" on the server and fill in real values.
# Never commit or FTP the real .env. NGINX on the host handles TLS;
# containers are bound to 127.0.0.1 only.

# --- Postgres ---
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=job_tracker

# --- App secrets (generate with: openssl rand -base64 48) ---
JWT_SECRET=change-me

# --- AI (optional - leave empty to disable AI features) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Domains (nginx proxies 127.0.0.1:8137 / 127.0.0.1:8136) ---
FRONTEND_URL=https://jobtracker.domain.com
ALLOWED_ORIGINS=["https://jobtracker.domain.com"]
NEXT_PUBLIC_API_URL=https://jobtracker.domain.com

# --- Runtime ---
DEBUG=false
# API docs (Swagger UI at /docs) are disabled by default. Set true to enable.
SHOW_API_DOCS=false
# Session cookie flag: MUST be true over HTTPS (nginx in front).
COOKIE_SECURE=true
# Set true when the API runs behind a reverse proxy (nginx here) that
# overwrites X-Forwarded-For with the real client IP, so rate limits
# (login/register/resend) key on real addresses instead of the proxy.
TRUST_PROXY_HEADERS=true
# Backend runs a single uvicorn worker by default. Do not raise
# UVICORN_WORKERS unless the config source is shared across processes:
# admin-saved SMTP/AI overrides are applied per-process.

# --- Email verification (double opt-in) ---
# Required to send verification emails on registration. Can also be set from
# the admin Settings page (persisted in the DB) instead of here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=JobApplicationTracker
# Optional: blind-copy every outgoing email to this address.
SMTP_BCC=
SMTP_TLS=true
SMTP_SSL=false
